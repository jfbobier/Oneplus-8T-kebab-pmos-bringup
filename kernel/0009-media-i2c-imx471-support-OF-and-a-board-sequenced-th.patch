From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kebab refactor <kebab@local.invalid>
Date: Wed, 30 Sep 2026 01:40:19 +0200
Subject: [PATCH] media: i2c: imx471: support OF and a board-sequenced
 three-rail supply

The upstream driver manages exactly one regulator:

	static const char * const imx471_supply_name[] = { "vana" };

which is right for the platform it was written for -- an Intel IPU x86
machine, where VDIG and VIO are board rails that firmware brings up
before the OS runs. It is not how a phone powers this sensor.

On the OnePlus 8T the vendor sequences three rails plus clock and
reset. Recovered from the stock sensor-module descriptor
(com.qti.sensormodule.truly_imx471.bin, a QTI Chromatix "Parameter
Parser V2.0.0" container; descriptor table of 32-byte name + 5 u64 at
stride 0x48 from 0xf0, data base 0x142f0, two 120-byte powerSetting
arrays of five 24-byte {seq_type, config_val, delay} records, seq_type
per enum msm_camera_power_seq_type):

	powerSetting[0] up    VANA VDIG VIO MCLK(19200000) RESET
	powerSetting[1] down  RESET MCLK VIO VDIG VANA

The MCLK record's config_val is 0x0124f800 = 19200000, matching
clock-rates in the vendor devicetree, which is the checksum confirming
the layout decode.

Leaving VDIG and VIO permanently on in the devicetree so the driver
only has to deal with "vana" inverts the first three steps and means
the die never cold-starts. Sony parts commonly need the analog rail
first to avoid latching through internal ESD structures, and a latched
die does not answer I2C -- which presented as a clean address-phase
NACK from a sensor whose EEPROM neighbour, fed from VIO, answered
normally.

Claim all three supplies, enable them individually in vendor order 1 ms
apart instead of using regulator_bulk_enable(), then the clock, then
release reset. Power-down walks the array backwards, giving exactly the
vendor's reverse order. Boards that only wire "vana" are unaffected:
the two extra supplies resolve to dummies.

Also add an of_match_table so the driver can be instantiated from a
devicetree.
---
 drivers/media/i2c/imx471.c | 77 +++++++++++++++++++++++++++++++-------
 1 file changed, 64 insertions(+), 13 deletions(-)

diff --git a/drivers/media/i2c/imx471.c b/drivers/media/i2c/imx471.c
index 4053aed84..b960737ca 100644
--- a/drivers/media/i2c/imx471.c
+++ b/drivers/media/i2c/imx471.c
@@ -9,6 +9,7 @@
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/i2c.h>
+#include <linux/of.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
 #include <linux/regulator/consumer.h>
@@ -116,8 +117,25 @@
 
 #define to_imx471(_sd) container_of_const(_sd, struct imx471, sd)
 
+/*
+ * Vendor power-up order, recovered from the stock sensor module
+ * descriptor odm/lib64/camera/com.qti.sensormodule.truly_imx471.bin
+ * (QTI Chromatix "Parameter Parser V2.0.0", powerSetting[0], five
+ * 24-byte {seq_type, config_val, delay} records):
+ *
+ *   VANA -> VDIG -> VIO -> MCLK(19200000) -> RESET
+ *
+ * powerSetting[1] is the exact reverse for power-down. The MCLK
+ * record's config_val decodes to 0x0124f800 = 19200000, matching
+ * clock-rates in the vendor devicetree, which confirms the layout.
+ *
+ * Order matters here: VANA must lead. This array is enabled in
+ * index order by imx471_power_on().
+ */
 static const char * const imx471_supply_name[] = {
 	"vana",
+	"vdig",
+	"vio",
 };
 
 struct imx471_mode {
@@ -519,12 +537,19 @@ static int imx471_power_off(struct device *dev)
 {
 	struct v4l2_subdev *sd = dev_get_drvdata(dev);
 	struct imx471 *sensor = to_imx471(sd);
+	unsigned int i = ARRAY_SIZE(imx471_supply_name);
 
-	clk_disable_unprepare(sensor->img_clk);
+	/* Exact reverse of power-on: RESET, MCLK, VIO, VDIG, VANA. */
 	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	usleep_range(1000, 2000);
 
-	regulator_bulk_disable(ARRAY_SIZE(imx471_supply_name),
-			       sensor->supplies);
+	clk_disable_unprepare(sensor->img_clk);
+	usleep_range(1000, 2000);
+
+	while (i--) {
+		regulator_disable(sensor->supplies[i].consumer);
+		usleep_range(1000, 2000);
+	}
 
 	return 0;
 }
@@ -533,28 +558,47 @@ static int imx471_power_on(struct device *dev)
 {
 	struct v4l2_subdev *sd = dev_get_drvdata(dev);
 	struct imx471 *sensor = to_imx471(sd);
+	unsigned int i;
 	int ret;
 
-	ret = regulator_bulk_enable(ARRAY_SIZE(imx471_supply_name),
-				    sensor->supplies);
-	if (ret < 0) {
-		dev_err(dev, "failed to enable regulators: %d\n", ret);
-		return ret;
+	/*
+	 * Hold the sensor in reset across the whole rail bring-up. The vendor
+	 * power-down sequence leaves RESET asserted, so this is also the state
+	 * the part expects to start from.
+	 */
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+
+	/* VANA -> VDIG -> VIO, 1ms apart, per the vendor descriptor. */
+	for (i = 0; i < ARRAY_SIZE(imx471_supply_name); i++) {
+		ret = regulator_enable(sensor->supplies[i].consumer);
+		if (ret < 0) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				imx471_supply_name[i], ret);
+			goto err_supplies;
+		}
+		usleep_range(1000, 2000);
 	}
 
 	ret = clk_prepare_enable(sensor->img_clk);
 	if (ret < 0) {
-		regulator_bulk_disable(ARRAY_SIZE(imx471_supply_name),
-				       sensor->supplies);
 		dev_err(dev, "failed to enable imaging clock: %d\n", ret);
-		return ret;
+		goto err_supplies;
 	}
+	usleep_range(1000, 2000);
 
-	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	dev_info(dev, "imx471: rails up (vana,vdig,vio), img_clk = %lu Hz\n",
+		 clk_get_rate(sensor->img_clk));
 
-	usleep_range(10000, 15000);
+	/* Release RESET last. */
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	usleep_range(50000, 60000);
 
 	return 0;
+
+err_supplies:
+	while (i--)
+		regulator_disable(sensor->supplies[i].consumer);
+	return ret;
 }
 
 static int imx471_enable_stream(struct v4l2_subdev *sd,
@@ -939,10 +983,17 @@ static const struct acpi_device_id imx471_acpi_ids[] __maybe_unused = {
 };
 MODULE_DEVICE_TABLE(acpi, imx471_acpi_ids);
 
+static const struct of_device_id imx471_of_ids[] __maybe_unused = {
+	{ .compatible = "sony,imx471" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx471_of_ids);
+
 static struct i2c_driver imx471_i2c_driver = {
 	.driver = {
 		.name = "imx471",
 		.acpi_match_table = ACPI_PTR(imx471_acpi_ids),
+		.of_match_table = imx471_of_ids,
 		.pm = pm_sleep_ptr(&imx471_pm_ops),
 	},
 	.probe = imx471_probe,
