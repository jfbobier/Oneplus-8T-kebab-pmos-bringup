maintainer="Jianhua Lu <lujianhua000@gmail.com>"
_flavor="postmarketos-qcom-sm8250"
pkgname=linux-$_flavor
pkgver=7.2.0
pkgrel=23
pkgdesc="Mainline kernel fork for SM8250"
arch="aarch64"
_carch="arm64"
url="https://gitlab.postmarketos.org/soc/qualcomm-sm8250/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	pmb:kconfigcheck-community
	pmb:kconfigcheck-uefi
"
makedepends="
	bash
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
"

# Source
_tag="sm8250-$pkgver"
_config="config-$_flavor.$arch"

# The OnePlus 8T (kebab) board devicetree is maintained as a whole file
# rather than as a stack of patches -- see docs/REFACTOR.md. prepare()
# drops it over the in-tree copy. Everything in $_kebab_patches is a real
# C-level change; anything that could be expressed as board description or
# as userspace policy is not here.
_kebab_dts="sm8250-oneplus-kebab.dts"

source="
	$pkgname-$_tag.tar.gz::https://gitlab.postmarketos.org/soc/qualcomm-sm8250/linux/-/archive/$_tag/linux-$_tag.tar.gz
	$_config
	$_kebab_dts
	0001-drm-panel-add-Samsung-AMB655X-panel-driver.patch
	0002-input-touchscreen-add-Synaptics-TCM-oncell-driver.patch
	0003-regulator-add-MP2762A-OTG-VBUS-regulator.patch
	0004-drm-msm-dp-don-t-apply-the-wide-bus-pixel-clock-halv.patch
	0005-usb-typec-displayport-defer-instead-of-failing-when-.patch
	0006-ASoC-add-NXP-Goodix-TFA2-TFA9874-DSP-bypass-amplifie.patch
	0007-ASoC-wcd938x-initialise-the-TX-channel-HPF-on-analog.patch
	0008-media-i2c-imx471-import-the-upstream-Sony-IMX471-sen.patch
	0009-media-i2c-imx471-support-OF-and-a-board-sequenced-th.patch
	0010-bus-mhi-host-add-a-Sahara-v2-firmware-loader-for-fla.patch
	0011-bus-mhi-pci_generic-add-the-phone-embedded-SDX55-Fus.patch
	0012-bus-mhi-pci_generic-don-t-re-enable-runtime-PM-on-no.patch
	0013-net-wwan-expose-the-Qualcomm-remote-EFS-MHI-channel-.patch
	0014-drm-msm-dp-don-t-gate-link-training-fallback-on-the-.patch
	0015-drm-msm-dp-fix-NULL-dereference-reading-the-DP-test-.patch
	0016-usb-typec-qcom-stop-logging-the-no-op-signal-transmi.patch
	0017-ASoC-codecs-wcd938x-don-t-log-an-impedance-ramp-with.patch
	0018-remoteproc-qcom_q6v5-don-t-log-a-repeated-handover-s.patch
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare

	# Whole-file board devicetree. If this ever stops matching what the
	# kernel expects, scripts/check-dts-drift.sh shows what moved.
	cp "$srcdir/$_kebab_dts" \
		"$builddir/arch/arm64/boot/dts/qcom/$_kebab_dts"

	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot

	if [ -e "$builddir/arch/$_carch/boot/vmlinuz.efi" ]; then
		# ZBOOT EFI decompressor for EFI booting
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
			"$pkgdir/boot/linux.efi"

		# Old GZIP'd kernel image for boot.img compatibility
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" \
			"$pkgdir/boot/vmlinuz"
	else
		echo "WARNING: CONFIG_ZBOOT not enabled!"
		install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
			"$pkgdir/boot/vmlinuz"
	fi

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

