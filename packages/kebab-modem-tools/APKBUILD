# Maintainer: kebab bring-up <kebab@example.com>
pkgname=kebab-modem-tools
pkgver=1.1
pkgrel=0
pkgdesc="Userspace services the SDX55 expects on the AP (OnePlus 8T / kebab)"
url="https://github.com/royka1/Xiaomi-Apollo-pmOS-packages"
arch="aarch64"
license="GPL-2.0-only"
makedepends="linux-headers"
options="!check"
source="
	pm_service_native.c
	diag_reader.c
	mhi_efs_sync.c
	pm-service-native.service
	mhi-efs-sync.service
"
builddir="$srcdir"

# pm_service_native answers the Peripheral Manager QMI service, which the
# modem needs before it will touch secure NV.
#
# mhi_efs_sync services the remote-EFS channel the kernel exposes as
# /dev/wwan0efs0. The SDX55 firmware is an RMTEFS build and expects the AP
# to host its filesystem; unserviced, its EFS stays RAM-backed from the
# static Sahara images, its NV never persists, and it ERRFATALs a fixed
# ~65 s after its first EFS-Sync. Android does this job with
# /vendor/bin/ks.
#
# diag_reader reads the modem's own F3 log over DIAG -- the only way to see
# what the firmware thinks. Not needed for normal operation.
#
# mdm_helper_native is deliberately NOT built: it drives the ESOC request
# engine through debugfs and /dev/esoc, and kebab has no ESOC driver (the
# AP2MDM sideband is done with devicetree gpio-hogs instead).
build() {
	$CC $CFLAGS $LDFLAGS -o pm_service_native "$srcdir"/pm_service_native.c
	$CC $CFLAGS $LDFLAGS -o diag_reader "$srcdir"/diag_reader.c
	$CC $CFLAGS $LDFLAGS -o mhi_efs_sync "$srcdir"/mhi_efs_sync.c
}

package() {
	install -Dm755 "$srcdir"/pm_service_native "$pkgdir"/usr/bin/pm_service_native
	install -Dm755 "$srcdir"/diag_reader "$pkgdir"/usr/bin/diag_reader
	install -Dm755 "$srcdir"/mhi_efs_sync "$pkgdir"/usr/bin/mhi_efs_sync
	install -Dm644 "$srcdir"/pm-service-native.service \
		"$pkgdir"/usr/lib/systemd/system/pm-service-native.service
	install -Dm644 "$srcdir"/mhi-efs-sync.service \
		"$pkgdir"/usr/lib/systemd/system/mhi-efs-sync.service
}
