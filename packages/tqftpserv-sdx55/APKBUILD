# Maintainer: kebab <kebab@example.com>
pkgname=tqftpserv-sdx55
pkgver=1.0
pkgrel=1
pkgdesc="TFTP/RFS server over QRTR, patched for the PCIe-attached SDX55 (kebab)"
url="https://github.com/royka1/Xiaomi-Apollo-pmOS-packages"
arch="aarch64"
license="BSD-3-Clause"
depends="qrtr"
makedepends="qrtr-dev zstd-dev"
options="!check !strip"
source="
	tqftpserv.c
	translate.c
	zstd-decompress.c
	list.h
	translate.h
	zstd-decompress.h
	tqftpserv-sdx55.service
"
builddir="$srcdir"

# Two changes against upstream tqftpserv, both genuine upstream bugs:
#  1. qrtr_publish(fd, 4096, 1, 0) -> (fd, 4096, 3, 0). The PCIe-attached
#     SDX55 looks up instance 3; upstream only publishes instance 1.
#  2. tftp_send_data() discarded send() failures; at blksize=7680 x wsize=10
#     the QRTR send buffer runs out and the stalled transfer ERRFATALs the
#     modem ~64 s later. send_retry() polls POLLOUT and retries.
build() {
	$CC $CFLAGS $LDFLAGS -DHAVE_ZSTD -o tqftpserv-sdx55 \
		"$srcdir"/tqftpserv.c "$srcdir"/translate.c "$srcdir"/zstd-decompress.c \
		-I"$srcdir" -lqrtr -lzstd
}

package() {
	install -Dm755 "$srcdir"/tqftpserv-sdx55 "$pkgdir"/usr/bin/tqftpserv-sdx55
	install -Dm644 "$srcdir"/tqftpserv-sdx55.service \
		"$pkgdir"/usr/lib/systemd/system/tqftpserv-sdx55.service
}
