# Reference: <https://postmarketos.org/devicepkg>
maintainer="Frieder Hannenheim <git@fhannenheim.net>"
pkgname=device-oneplus-kebab
pkgdesc="OnePlus 8T"
pkgver=8
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	bluez
	firmware-oneplus-instantnoodlep
	linux-postmarketos-qcom-sm8250
	mkbootimg
	postmarketos-base
"
makedepends="
	devicepkg-dev
	dtc
"
subpackages="
	$pkgname-audio
	$pkgname-modem
"
source="
	deviceinfo
	sm8250-oneplus-kebab-empty.dts
	90-kebab-bluetooth-addr.rules
	kebab-bluetooth-addr
	kebab-bluetooth-addr@.service
	77-mm-ignore-sdx55-efs.rules
	77-mm-sdx55-fusion.rules
	90-kebab-mhi-debug.conf
	kebab-uim-provision
	kebab-uim-provision.service
	kebab-pcie2-no-runtime-pm.service
	ucm-OnePlus-8T.conf
	ucm-HiFi.conf
"

build() {
	devicepkg_build $startdir $pkgname

	dtc -O dtb -o "$srcdir/dtbo.img" -I dts "$srcdir/sm8250-oneplus-kebab-empty.dts"
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"

	# Per-device Bluetooth address. The QCA6390 firmware ships a
	# placeholder, so the controller registers unconfigured and bluetoothd
	# never sees an adapter; this assigns a locally administered address
	# derived from /etc/machine-id rather than baking one constant into
	# the devicetree.
	install -Dm755 "$srcdir"/kebab-bluetooth-addr \
		"$pkgdir"/usr/bin/kebab-bluetooth-addr
	install -Dm644 "$srcdir"/kebab-bluetooth-addr@.service \
		"$pkgdir"/usr/lib/systemd/system/kebab-bluetooth-addr@.service
	install -Dm644 "$srcdir"/90-kebab-bluetooth-addr.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-kebab-bluetooth-addr.rules
}

audio() {
	pkgdesc="$pkgdesc (ALSA UCM profile)"
	depends="alsa-ucm-conf"
	install_if="$pkgname=$pkgver-r$pkgrel alsa-ucm-conf"

	# The conf.d file name must match the ALSA card name exactly, spaces
	# included, so it is shipped under a flat name and renamed on install.
	install -Dm644 "$srcdir"/ucm-OnePlus-8T.conf \
		"$subpkgdir/usr/share/alsa/ucm2/conf.d/sm8250/OnePlus 8T.conf"
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$subpkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8250/OnePlus8T/HiFi.conf
}

modem() {
	pkgdesc="$pkgdesc (SDX55 modem integration)"
	depends="
		libqmi
		modemmanager
		tqftpserv-sdx55
		kebab-modem-tools
	"

	# ModemManager must not AT-probe the EFS transport: the modem's
	# rmts_srv receives the strings as garbage and ERRFATALs within two
	# seconds. This rule is mandatory whenever the kernel exposes
	# /dev/wwan0efs0.
	install -Dm644 "$srcdir"/77-mm-ignore-sdx55-efs.rules \
		"$subpkgdir"/usr/lib/udev/rules.d/77-mm-ignore-sdx55-efs.rules
	install -Dm644 "$srcdir"/77-mm-sdx55-fusion.rules \
		"$subpkgdir"/usr/lib/udev/rules.d/77-mm-sdx55-fusion.rules

	# Why the mhi module is loaded with all its dev_dbg sites on, what it
	# costs, and how to turn it off. See NOISE-3 in docs/REGRESSIONS.md.
	install -Dm644 "$srcdir"/90-kebab-mhi-debug.conf \
		"$subpkgdir"/usr/lib/modprobe.d/90-kebab-mhi-debug.conf

	install -Dm755 "$srcdir"/kebab-uim-provision \
		"$subpkgdir"/usr/bin/kebab-uim-provision

	# mhi-efs-sync.service ships with kebab-modem-tools and
	# tqftpserv-sdx55.service with tqftpserv-sdx55, next to the binaries
	# they start. These two are board policy.
	install -Dm644 "$srcdir"/kebab-uim-provision.service \
		"$subpkgdir"/usr/lib/systemd/system/kebab-uim-provision.service

	# Pinning the PCIe2 *host controller* out of runtime suspend is still
	# needed even with the MHI no_m3 fix in the kernel: pcie-qcom's own
	# runtime suspend gates the PIPE clocks and puts the PHY in low power,
	# which drops the link under the modem. Enable this one.
	install -Dm644 "$srcdir"/kebab-pcie2-no-runtime-pm.service \
		"$subpkgdir"/usr/lib/systemd/system/kebab-pcie2-no-runtime-pm.service
	install -d "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../kebab-pcie2-no-runtime-pm.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/kebab-pcie2-no-runtime-pm.service
}

