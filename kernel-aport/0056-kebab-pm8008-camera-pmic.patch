diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-kebab.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-kebab.dts
index 23105797a..2bb30b439 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-kebab.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-kebab.dts
@@ -1836,3 +1836,83 @@ data-pins {
 		};
 	};
 };
+
+&i2c2 {
+	status = "okay";
+
+	pm8008: pmic@8 {
+		compatible = "qcom,pm8008";
+		reg = <0x8>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <112 IRQ_TYPE_EDGE_RISING>;
+
+		vdd-l1-l2-supply = <&vreg_s8c_1p3>;
+		vdd-l3-l4-supply = <&vreg_bob>;
+		vdd-l5-supply = <&vreg_bob>;
+		vdd-l6-supply = <&vreg_bob>;
+		vdd-l7-supply = <&vreg_bob>;
+
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&pm8008 0 0 2>;
+
+		interrupt-controller;
+		#interrupt-cells = <2>;
+
+		#thermal-sensor-cells = <0>;
+
+		regulators {
+			L1P: ldo1 {
+				regulator-name = "pm8008_l1";
+				regulator-min-microvolt = <528000>;
+				regulator-max-microvolt = <1200000>;
+				/* cam_vdig for the front sensor (1.1V, per
+				 * kebab-19805-camera.dts's cam-sensor@2). imx471.c
+				 * only regulator_bulk_gets "vana" itself, so keep
+				 * this fixed rail up rather than plumb a driver
+				 * change for it. */
+				regulator-always-on;
+			};
+
+			L2P: ldo2 {
+				regulator-name = "pm8008_l2";
+				regulator-min-microvolt = <528000>;
+				regulator-max-microvolt = <1200000>;
+			};
+
+			L3P: ldo3 {
+				regulator-name = "pm8008_l3";
+				regulator-min-microvolt = <1500000>;
+				regulator-max-microvolt = <3400000>;
+			};
+
+			L4P: ldo4 {
+				regulator-name = "pm8008_l4";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				/* cam_vio, shared by every sensor per
+				 * kebab-19805-camera.dts. Same reasoning as L1P. */
+				regulator-always-on;
+			};
+
+			L5P: ldo5 {
+				regulator-name = "pm8008_l5";
+				regulator-min-microvolt = <1500000>;
+				regulator-max-microvolt = <3400000>;
+			};
+
+			L6P: ldo6 {
+				regulator-name = "pm8008_l6";
+				regulator-min-microvolt = <1500000>;
+				regulator-max-microvolt = <3400000>;
+			};
+
+			L7P: ldo7 {
+				regulator-name = "pm8008_l7";
+				regulator-min-microvolt = <1500000>;
+				regulator-max-microvolt = <3400000>;
+			};
+		};
+	};
+};
