+	MHI_CHANNEL_CONFIG_UL(10, "EFS", 64, 1),
+	MHI_CHANNEL_CONFIG_DL(11, "EFS", 64, 1),
+	MHI_CHANNEL_CONFIG_UL(12, "MBIM", 4, 0),
