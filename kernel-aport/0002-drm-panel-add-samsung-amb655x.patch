drm/panel: add Samsung AMB655X panel driver

Ported to the 7.2.0 API: mipi_dsi_multi_context for the standard
helpers, a local forced-DCS-long-write helper to preserve the
original packet types, and devm_drm_panel_alloc() in place of the
removed drm_panel_init().

--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-amb655x.c
@@ -0,0 +1,493 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (c) 2024 Caleb Connolly <caleb.connolly@linaro.org>
+// Generated with linux-mdss-dsi-panel-driver-generator from vendor device tree:
+//   Copyright (c) 2015-2017, The Linux Foundation. All rights reserved.
+//
+// Ported to the 7.2.0 mipi_dsi_multi_context API.
+//
+// Two things about this driver are deliberate and should not be "cleaned up":
+//
+//  1. Every vendor init command is sent as a forced DCS LONG WRITE, even the
+//     one- and two-byte ones. The stock driver does the same. The generic
+//     helpers pick the packet type from the payload length, which would turn
+//     roughly forty of these into short writes. amb655x_write_long() below
+//     exists solely to preserve the original wire format.
+//
+//  2. The reset GPIO is never driven. Upstream's note on this panel: it works
+//     if reset is skipped, and with reset the backlight comes up but the panel
+//     displays garbage while the DSI stack throws errors. The bootloader has
+//     already brought the panel out of reset by the time we get here, so we
+//     leave it alone.
+
+#define DEBUG
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct samsung_amb655x {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset_gpio;
+};
+
+static inline
+struct samsung_amb655x *to_samsung_amb655x(struct drm_panel *panel)
+{
+	return container_of(panel, struct samsung_amb655x, panel);
+}
+
+/*
+ * Send a payload as a DCS long write regardless of its length, accumulating
+ * errors into the multi-context the same way the core helpers do.
+ *
+ * This open-codes what the core's static mipi_dsi_device_transfer() does,
+ * because that function is private and the public helpers all choose the
+ * packet type for us.
+ */
+static void amb655x_dcs_write_long(struct mipi_dsi_multi_context *ctx,
+				   const void *payload, size_t size)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_msg msg = {
+		.channel = dsi->channel,
+		.tx_buf  = payload,
+		.tx_len  = size,
+		.type    = MIPI_DSI_DCS_LONG_WRITE,
+	};
+	ssize_t ret;
+
+	if (ctx->accum_err)
+		return;
+
+	if (!dsi->host->ops || !dsi->host->ops->transfer) {
+		ctx->accum_err = -ENOSYS;
+		return;
+	}
+
+	if (dsi->mode_flags & MIPI_DSI_MODE_LPM)
+		msg.flags |= MIPI_DSI_MSG_USE_LPM;
+
+	ret = dsi->host->ops->transfer(dsi->host, &msg);
+	if (ret < 0) {
+		ctx->accum_err = ret;
+		dev_err(&dsi->dev,
+			"DCS long write (cmd 0x%02x, %zu bytes) failed: %zd\n",
+			*(const u8 *)payload, size, ret);
+	}
+}
+
+#define amb655x_write_long(ctx, cmd, seq...)				\
+	do {								\
+		static const u8 d[] = { cmd, seq };			\
+		amb655x_dcs_write_long(ctx, d, ARRAY_SIZE(d));		\
+	} while (0)
+
+static void samsung_amb655x_reset(struct samsung_amb655x *ctx)
+{
+	/* See note 2 at the top of this file: reset is intentionally skipped. */
+	// gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	// gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	// gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static int samsung_amb655x_on(struct samsung_amb655x *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+	struct drm_dsc_picture_parameter_set pps;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	/*
+	 * The PPS is packed here for reference/debug only. It is transmitted
+	 * as the 0x9e vendor command below rather than via
+	 * mipi_dsi_picture_parameter_set(), because the panel expects it
+	 * inside its own unlock sequence. The generated payload matches the
+	 * downstream one byte for byte.
+	 */
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+
+	amb655x_write_long(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	amb655x_write_long(&dsi_ctx, 0x9e,
+			   0x11, 0x00, 0x00, 0x89, 0x30, 0x80, 0x09, 0x60,
+			   0x04, 0x38, 0x00, 0x1e, 0x02, 0x1c, 0x02, 0x1c,
+			   0x02, 0x00, 0x02, 0x0e, 0x00, 0x20, 0x02, 0xe3,
+			   0x00, 0x07, 0x00, 0x0c, 0x03, 0x50, 0x03, 0x64,
+			   0x18, 0x00, 0x10, 0xf0, 0x03, 0x0c, 0x20, 0x00,
+			   0x06, 0x0b, 0x0b, 0x33, 0x0e, 0x1c, 0x2a, 0x38,
+			   0x46, 0x54, 0x62, 0x69, 0x70, 0x77, 0x79, 0x7b,
+			   0x7d, 0x7e, 0x01, 0x02, 0x01, 0x00, 0x09, 0x40,
+			   0x09, 0xbe, 0x19, 0xfc, 0x19, 0xfa, 0x19, 0xf8,
+			   0x1a, 0x38, 0x1a, 0x78, 0x1a, 0xb6, 0x2a, 0xf6,
+			   0x2b, 0x34, 0x2b, 0x74, 0x3b, 0x74, 0x6b, 0xf4,
+			   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+			   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+			   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+			   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+			   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+	amb655x_write_long(&dsi_ctx, 0x9d, 0x01);
+	amb655x_write_long(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_usleep_range(&dsi_ctx, 11000, 12000);
+
+	/* VLIN current limit */
+	amb655x_write_long(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	amb655x_write_long(&dsi_ctx, 0xb0, 0x04);
+	amb655x_write_long(&dsi_ctx, 0xd5, 0x24, 0x9e, 0x9e, 0x00, 0x20);
+	amb655x_write_long(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* OSC select */
+	amb655x_write_long(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	amb655x_write_long(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	amb655x_write_long(&dsi_ctx, 0xb0, 0x16);
+	amb655x_write_long(&dsi_ctx, 0xd1, 0x22);
+	amb655x_write_long(&dsi_ctx, 0xd6, 0x11);
+	amb655x_write_long(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	amb655x_write_long(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* Tearing effect on */
+	amb655x_write_long(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	amb655x_write_long(&dsi_ctx, MIPI_DCS_SET_TEAR_ON,
+			   MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	amb655x_write_long(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* Touch panel handshake */
+	amb655x_write_long(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	amb655x_write_long(&dsi_ctx, 0xdf, 0x83, 0x00, 0x10);
+	amb655x_write_long(&dsi_ctx, 0xb0, 0x01);
+	amb655x_write_long(&dsi_ctx, 0xe6, 0x01);
+	amb655x_write_long(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	mipi_dsi_dcs_set_column_address_multi(&dsi_ctx, 0x0000, 1080 - 1);
+	mipi_dsi_dcs_set_page_address_multi(&dsi_ctx, 0x0000, 2400 - 1);
+
+	/* FD setting */
+	amb655x_write_long(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	amb655x_write_long(&dsi_ctx, 0xd5, 0x8d);
+	amb655x_write_long(&dsi_ctx, 0xb0, 0x0a);
+	amb655x_write_long(&dsi_ctx, 0xd5, 0x05);
+	amb655x_write_long(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* FFC */
+	amb655x_write_long(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	amb655x_write_long(&dsi_ctx, 0xb0, 0x01);
+	amb655x_write_long(&dsi_ctx, 0xe4, 0xa6, 0x75, 0xa3);
+	amb655x_write_long(&dsi_ctx, 0xe9,
+			   0x11, 0x75, 0xa6, 0x75, 0xa3, 0x4b, 0x17, 0xac,
+			   0x4b, 0x17, 0xac, 0x00, 0x19, 0x19);
+	amb655x_write_long(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	mipi_dsi_msleep(&dsi_ctx, 61);
+
+	/* Dimming */
+	amb655x_write_long(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	amb655x_write_long(&dsi_ctx, 0xb0, 0x06);
+	amb655x_write_long(&dsi_ctx, 0xb7, 0x01);
+	amb655x_write_long(&dsi_ctx, 0xb0, 0x05);
+	amb655x_write_long(&dsi_ctx, 0xb7, 0x13);
+	amb655x_write_long(&dsi_ctx, 0xb0, 0x01);
+	amb655x_write_long(&dsi_ctx, 0xb7, 0x4c);
+	amb655x_write_long(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	amb655x_write_long(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x20);
+
+	/* Refresh rate: 0x00 selects 60 Hz, 0x10 selects 120 Hz */
+	amb655x_write_long(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	amb655x_write_long(&dsi_ctx, 0x60, 0x10);
+	amb655x_write_long(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* ACL mode */
+	amb655x_write_long(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	amb655x_write_long(&dsi_ctx, MIPI_DCS_WRITE_POWER_SAVE, 0x00);
+	amb655x_write_long(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x20);
+	mipi_dsi_msleep(&dsi_ctx, 110);
+
+	/* Enable backlight */
+	amb655x_write_long(&dsi_ctx, 0x9f, 0x5a, 0x5a);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_ENTER_NORMAL_MODE);
+	amb655x_write_long(&dsi_ctx, 0x9f, 0xa5, 0xa5);
+
+	return dsi_ctx.accum_err;
+}
+
+static int samsung_amb655x_off(struct samsung_amb655x *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	amb655x_write_long(&dsi_ctx, 0x9f, 0x5a, 0x5a);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+
+	amb655x_write_long(&dsi_ctx, 0x9f, 0xa5, 0xa5);
+	mipi_dsi_msleep(&dsi_ctx, 150);
+
+	return dsi_ctx.accum_err;
+}
+
+static int samsung_amb655x_prepare(struct drm_panel *panel)
+{
+	struct samsung_amb655x *ctx = to_samsung_amb655x(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	samsung_amb655x_reset(ctx);
+
+	ret = samsung_amb655x_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		return ret;
+	}
+
+	msleep(28);
+
+	return 0;
+}
+
+static int samsung_amb655x_enable(struct drm_panel *panel)
+{
+	/*
+	 * Display-on and normal-mode entry are done at the end of
+	 * samsung_amb655x_on(), inside the panel's unlock sequence.
+	 */
+	return 0;
+}
+
+static int samsung_amb655x_unprepare(struct drm_panel *panel)
+{
+	struct samsung_amb655x *ctx = to_samsung_amb655x(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = samsung_amb655x_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	return 0;
+}
+
+static const struct drm_display_mode samsung_amb655x_mode __maybe_unused = {
+	.clock = (1080 + 52 + 24 + 24) * (2400 + 1208 + 4 + 8) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 52,
+	.hsync_end = 1080 + 52 + 24,
+	.htotal = 1080 + 52 + 24 + 24,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 1208,
+	.vsync_end = 2400 + 1208 + 4,
+	.vtotal = 2400 + 1208 + 4 + 8,
+	.width_mm = 70,
+	.height_mm = 151,
+};
+
+static const struct drm_display_mode samsung_amb655x_120_mode = {
+	.clock = (1080 + 52 + 24 + 24) * (2400 + 4 + 4 + 8) * 120 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 52,
+	.hsync_end = 1080 + 52 + 24,
+	.htotal = 1080 + 52 + 24 + 24,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 4,
+	.vsync_end = 2400 + 4 + 4,
+	.vtotal = 2400 + 4 + 4 + 8,
+	.width_mm = 70,
+	.height_mm = 151,
+};
+
+static int samsung_amb655x_get_modes(struct drm_panel *panel,
+				     struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &samsung_amb655x_120_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs samsung_amb655x_panel_funcs = {
+	.prepare = samsung_amb655x_prepare,
+	.enable = samsung_amb655x_enable,
+	.unprepare = samsung_amb655x_unprepare,
+	.get_modes = samsung_amb655x_get_modes,
+};
+
+static int samsung_amb655x_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+static int samsung_amb655x_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness;
+	int ret;
+
+	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	if (ret < 0)
+		return ret;
+
+	return brightness;
+}
+
+static const struct backlight_ops samsung_amb655x_bl_ops = {
+	.update_status = samsung_amb655x_bl_update_status,
+	.get_brightness = samsung_amb655x_bl_get_brightness,
+};
+
+static struct backlight_device *
+samsung_amb655x_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 4095,
+		.max_brightness = 4095,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &samsung_amb655x_bl_ops, &props);
+}
+
+static int samsung_amb655x_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct samsung_amb655x *ctx;
+	int ret;
+
+	/*
+	 * drm_panel_init() was removed; devm_drm_panel_alloc() allocates the
+	 * containing struct and initialises the embedded drm_panel together.
+	 */
+	ctx = devm_drm_panel_alloc(dev, struct samsung_amb655x, panel,
+				   &samsung_amb655x_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	/*
+	 * No devm_gpiod_get() for reset. reset-gpios is present in the
+	 * devicetree for documentation and for a future fix, but driving it
+	 * here breaks the panel. See note 2 at the top of this file.
+	 */
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = samsung_amb655x_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	/* This panel only supports DSC; unconditionally enable it */
+	dsi->dsc = &ctx->dsc;
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+
+	ctx->dsc.slice_height = 30;
+	ctx->dsc.slice_width = 540;
+	WARN_ON(1080 % ctx->dsc.slice_width);
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+
+	/*
+	 * dsi->dsc_slice_per_pkt is left at 0, which msm treats as 1. The
+	 * original TODO asked for 2, but 1 is what the known-good 6.8 build
+	 * used, since the field did not exist then. If the panel lights up
+	 * but shows garbage or tearing, setting this to 2 is the first thing
+	 * to try.
+	 */
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void samsung_amb655x_remove(struct mipi_dsi_device *dsi)
+{
+	struct samsung_amb655x *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id samsung_amb655x_of_match[] = {
+	{ .compatible = "samsung,amb655x" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, samsung_amb655x_of_match);
+
+static struct mipi_dsi_driver samsung_amb655x_driver = {
+	.probe = samsung_amb655x_probe,
+	.remove = samsung_amb655x_remove,
+	.driver = {
+		.name = "panel-samsung-amb655x",
+		.of_match_table = samsung_amb655x_of_match,
+	},
+};
+module_mipi_dsi_driver(samsung_amb655x_driver);
+
+MODULE_AUTHOR("Caleb Connolly <caleb.connolly@linaro.org>");
+MODULE_DESCRIPTION("DRM driver for Samsung AMB655X FHD command mode DSC DSI panel");
+MODULE_LICENSE("GPL");
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -831,6 +831,17 @@
 	  Say Y here if you want to enable support for Ronbo Electronics
 	  RB070D30 1024x600 DSI panel.
 
+config DRM_PANEL_SAMSUNG_AMB655X
+	tristate "Samsung AMB655X DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_HELPER
+	select DRM_DISPLAY_DSC_HELPER
+	help
+	  DRM panel driver for the Samsung AMB655X panel, as found in the
+	  OnePlus 8T. 1080x2400 command mode with DSC, 60 or 120 Hz.
+
 config DRM_PANEL_SAMSUNG_AMS581VF01
 	tristate "Samsung AMS581VF01 panel"
 	depends on OF
--- a/drivers/gpu/drm/panel/Makefile
