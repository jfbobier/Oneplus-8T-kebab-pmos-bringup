--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-kebab.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-kebab.dts
@@ -1285,3 +1285,36 @@
 		};
 	};
 };
+
+/*
+ * The q6 DAI child nodes.
+ *
+ * q6asmdai and q6afedai in sm8250.dtsi are empty containers. Their drivers
+ * register DAIs by walking child nodes, so every DAI a board references
+ * has to be declared here. Without them the card fails to probe with:
+ *
+ *   sound snd-sm8250: MultiMedia1: error getting cpu dai name
+ *
+ * The unit addresses are the numeric DAI ids from
+ * dt-bindings/sound/qcom,q6asm.h and qcom,q6afe.h.
+ */
+
+&q6asmdai {
+	dai@0 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+	};
+
+	dai@1 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+	};
+};
+
+&q6afedai {
+	dai@71 {
+		reg = <RX_CODEC_DMA_RX_0>;
+	};
+
+	dai@78 {
+		reg = <TX_CODEC_DMA_TX_3>;
+	};
+};
